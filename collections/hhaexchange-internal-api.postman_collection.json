          "name": "Get provider details",
          "request": {
            "name": "Get provider details",
            "description": {
              "content": "Returns base URL, provider and user details, environment, and validation. Client ID, API key, and ProviderTaxId are required. Environment and HHA session use ClientMappings.Env for the resolved agency. AppVersionId is optional; when omitted, BaseUrl, ProviderVersion, and ProviderMinorVersion are null; ProviderId is the resolved VendorID (same as Validation.VendorID).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "internal",
                "provider"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "ClientId",
                  "value": "<string>",
                  "description": "(Required) Client ID (mandatory)"
                },
                {
                  "disabled": false,
                  "key": "XApiKey",
                  "value": "<string>",
                  "description": "(Required) API key (mandatory)"
                },
                {
                  "disabled": false,
                  "key": "ProviderTaxId",
                  "value": "<string>",
                  "description": "Provider tax ID (mandatory; resolves agency and mapping env)"
                },
                {
                  "disabled": false,
                  "key": "AppVersionId",
                  "value": "<integer>",
                  "description": "One or more app version IDs (optional; default [35]) for URL lookup."
