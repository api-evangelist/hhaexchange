      "item": [
        {
          "id": "35af9aa8-e7b2-47e1-ba69-884663c6485d",
          "name": "Get Rate Limit Configuration",
          "request": {
            "name": "Get Rate Limit Configuration",
            "description": {
              "content": "Retrieve the rate limit configuration for a specific client, agency, and environment combination. The triple (ClientId, AgencyId, Env) uniquely identifies one ClientMapping row on SB/PROD. On QA/IMPL (single HHA mirror), the resolved mapping may use a different stored Env than the query parameter; see response `Data.Env`. Returns the per-second or per-minute request limit stored on that mapping. Falls back to application defaults (50 / Minute) when no explicit configuration has been saved.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "rate-limits",
                "config"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "ClientId",
                  "value": "<string>",
                  "description": "FHIR client UUID (required). Example: 9b2f1a6e-3c84-4d8e-9b8a-7e2c9f2a1c45"
                },
                {
                  "disabled": false,
                  "key": "AgencyId",
                  "value": "<string>",
                  "description": "Agency (vendor) identifier — required; must be a positive integer"
                },
                {
                  "disabled": false,
                  "key": "Env",
                  "value": "<string>",
                  "description": "HHA environment (required): app, app2, or cloud"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "scope",
                  "value": "full_access"
                },
                {
                  "key": "accessTokenUrl",
                  "value": "https://api.hhaexchange.com/v1/fhir/auth/token"
                },
                {
                  "key": "grant_type",
                  "value": "client_credentials"
                }
              ]
            }
          },
          "response": [
            {
              "id": "9a72d17f-7391-4fca-905d-c4049c8e515d",
